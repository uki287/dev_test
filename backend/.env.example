# ============================================================
# 后端环境变量模板（复制为 .env 使用：cp .env.example .env）
# 注意：.env 含敏感配置，禁止提交到仓库（.gitignore 已排除）
# ============================================================

# JWT 签名密钥：生成随机值替换（Linux/macOS: openssl rand -hex 32；Windows: python -c "import secrets; print(secrets.token_urlsafe(48))"）
# 生产环境必须配置强随机密钥，否则启动时会告警
JWT_SECRET=change-me-to-a-random-secret

# 数据库连接：开发用 SQLite（默认）；生产切换 PostgreSQL
# 例：postgresql://user:pass@localhost:5432/tp_smart_home
DB_URL=sqlite:///./app.db

# Redis（缓存 + 限流；未启动时自动降级为内存实现）
REDIS_URL=redis://localhost:6379/0

# 调试模式
DEBUG=false

# CORS 允许来源（逗号分隔）
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
